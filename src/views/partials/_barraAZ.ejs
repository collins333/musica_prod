<div class="mb-4 text-center">
    <a href="<%= rutaBase %>" class="btn btn-sm <%= !letra ? 'btn-warning' : 'btn-outline-light' %> m-1">
      Todos
    </a>
    <% for(let i = 65; i <= 90; i++) { %>
      <%
       const l = String.fromCharCode(i); 
       const existe = letrasExistentes.includes(l);
      %>
      <% if(existe) { %>
        <a href="<%= rutaBase %>?letra=<%= l %>&<%= queryPagina %>=1" class="btn btn-sm <%= letra && letra.toUpperCase() === l ? `btn-warning` : `btn-outline-light`%> m-1">
          <%= l %>
        </a>
      <% } else { %>
        <button class="btn btn-sm btn-secondary m-1" disabled>
          <%= l %>
        </button>
      <% } %>
    <% } %>
  </div>