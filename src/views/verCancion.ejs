
<% include partials/_header %>

<% const disco = cancion.del_disco || {}; %>
<% const interprete = disco.interprete || {}; %>

<div class="container">
  <div class="card shadow-lg border-0 mb-4">
    <div class="row g-0">
      <!-- Portada -->
      <div class="col-md-4 text-center p-4">
        <a href="/verDisco/<%= disco._id %>?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>&paginaCanciones=<%= paginaCanciones %>">
          <img src="<%= disco.caratula %>" class="img-fluid rounded shadow" style="max-height: 400px; object-fit: contain; background-color: #111;" alt="<%= disco.titulo %>" onerror="this.onerror=null; this.src='/img/no-cover.jpg'">
        </a>
      </div>
      <!-- Info -->
      <div class="col-md-8">
        <div class="card-body h-100 d-flex flex-column justify-content-center">
          <h2 class="display-5 fw-bold mb-3">
            🎵 <%= cancion.tit_cancion %>
          </h2>
          <% if(cancion.artista_pista) { %>
            <h3>
              <span class="text-muted">
                <em><%= cancion.artista_pista %></em>
              </span>
            </h3>
          <% } %>
          <h4 class="mb-3">
            <a href="/verCantante/<%= interprete._id %>?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>&paginaDiscos=<%= paginaDiscos %>" class="text-decoration-none">
              <%= interprete.nombre %>              
            </a>
          </h4>
          <p class="mb-2">
            💿 <a href="/verDisco/<%= disco._id %>?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>&paginaCanciones=<%= paginaCanciones %>" class="text-decoration-none">
              <%= disco.titulo %>
            </a>
          </p>
          <% if (cancion.dur_cancion) { %>
            <p class="text-muted mb-4">
              ⏱ Duración: <%= cancion.dur_cancion %>
            </p>
          <% } %>
          <!-- Reproductor -->
          <% if (cancion.enlace) { %>
            <% if(disco.esAudioLocal) { %>
              <div class="mb-4">
                <audio controls style="width: 100%;">
                  <source src="<%= cancion.enlace %>" type="audio/mpeg">
                </audio>
              </div>
            <% } else { %>
              <div class="mb-4">
                <a href="<%= cancion.enlace %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-danger">
                  ▶ Ver / escuchar en YouTube
                </a>
              </div>
            <% } %>
          <% } %>
          <!-- Botones crud -->
          <% if(user) { %>
            <div class="d-flex gap-2 flex-wrap">
              <a href="/editCancion/<%= cancion._id %>?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>" class="btn btn-success">
                Editar
              </a>
              <form action="/deleteCancion/<%= cancion._id %>?_method=DELETE&<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>" method="post">
                <input type="hidden" name="_method" value="DELETE">
                <button class="btn btn-danger delete" type="submit">
                  Eliminar
                </button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <!-- Volver -->
  <div class="text-center mb-5">
    <a href="/canciones?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>" class="btn btn-volver">
      Volver a canciones
    </a>
    <a href="/verDisco/<%= cancion.del_disco._id %>?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>&paginaCanciones=<%= paginaCanciones %>" class="btn btn-volver">
      Volver al disco
    </a>
    <a href="/verCantante/<%= cancion.del_disco.interprete._id %>?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>&paginaDiscos=<%= paginaDiscos %>" class="btn btn-volver">
      Volver al intérprete
    </a>
  </div>
</div>
<script>
  let botones = document.querySelectorAll('.delete');
  for (const boton of botones) {  
    boton.addEventListener('click', (e) => {
      let respuesta = confirm('¿Estás seguro de querer eliminar esta canción?');
      if(!respuesta) {
        e.preventDefault();
      }
    });
  }
</script>

<% include partials/_footer %>