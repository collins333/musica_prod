<%- include('partials/_header') %>

<div class="container">
  <!-- Barra A-Z -->
  <%- include('partials/_barraAZ', {
    letrasExistentes,
    letra,
    rutaBase: '/cantantes',
    queryPagina: 'paginaCantantes'
  }) %>
  <!-- Encabezado -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">
      Intérpretes
    </h1>
    <div class="d-flex align-items-center gap-3">
        <% if(user) { %>
          <a href="/cantantes/nuevo?<%= query %>" class="btn btn-primary">
            Añadir intérprete
          </a>
        <% } %>
      <span class="text-muted">
        Página <%= paginaCantantes %> de <%= paginas %>
      </span>
    </div>
  </div>
  <!-- Cuerpo -->
  <div class="row g-4">
    <% interpretes.forEach(interprete => { %>
      <div class="col-6 col-md-3 col-lg-2">
        <div class="card-musica text-center h-100">
          <a href="/verCantante/<%= interprete._id %>?<%= query %>">
            <img src="<%= interprete.caratula %>" alt="<%= interprete.nombre %>" class="img-fluid rounded shadow-sm mb-2" style="height: 320px; object-fit: contain; background-color: #111;" onerror="this.onerror=null; this.src='/img/no-image.png'">
          </a>
          <h6 class="text-light">
            <a href="/verCantante/<%= interprete._id %>?<%= query %>" class="text-decoration-none text-light">
              <%= interprete.nombre %>
            </a>
          </h6>
        </div>
      </div>
    <% }) %>
  </div>
  <!-- Paginación -->
  <%- include('partials/_paginacion', {
    letra,
    pagina: paginaCantantes,
    paginas,
    rutaBase: '/cantantes',
    queryPagina: 'paginaCantantes'
  }) %>
</div>

<%- include('partials/_footer') %>