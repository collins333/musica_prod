<% if(paginas > 1) { %>
  <nav class="mt-5">
    <ul class="pagination justify-content-center">
      <!-- anterior -->
      <% if(pagina > 1) { %>
        <li class="page-item">
          <a class="page-link" href="<%= rutaBase %>?<%= letra ? `letra=${letra}&` : '' %><%= queryPagina %>=<%= pagina - 1 %>">
            Anterior
          </a>
        </li>
      <% } else { %>
        <li>
          <button class="btn btn-sm btn-secondary me-2" disabled>
            Anterior
          </button>
        </li>  
      <% } %>
      <% 
      const paginaActual = Number(pagina);
      let inicio = paginaActual - 4;
      let fin = paginaActual + 4;
      if(inicio < 1) {
        inicio = 1;
        fin = Math.min(9, paginas);
      }
      if(fin > paginas) {
        fin = paginas;
        inicio = Math.max(1, paginas - 8);
      }
      %>
      <!-- números -->
      <% for(let i=inicio; i<=fin; i++) { %>
        <li class="page-item <%= i === paginaActual ? 'active' : '' %>">
          <a class="page-link" href="<%= rutaBase %>?<%= letra ? `letra=${letra}&` : '' %><%= queryPagina %>=<%= i %>">
            <%= i %>
          </a>
        </li>
      <% } %>
      <!-- siguiente -->
      <% if(paginaActual < paginas) { %>
        <li class="page-item">
          <a class="page-link" href="<%= rutaBase %>?<%= letra ? `letra=${letra}&` : '' %><%= queryPagina %>=<%= pagina + 1 %>">
            Siguiente
          </a>
        </li>
      <% } else { %>
        <li>
          <button class="btn btn-sm btn-secondary me-2" disabled>
            Siguiente
          </button>
        </li>  
      <% } %>
    </ul>
  </nav>
<% } %>