<%- include('partials/_header') %>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
      <div class="card shadow border-0 mt-4">
        <div class="card-header cabecera">
          <h3 class="mb-0">🎤 Añadir nuevo intérprete</h3>
        </div>
        <div class="card-body">
          <form action="/cantantes" method="post">
            <!-- Nombre -->
            <div class="form-group mb-3">
              <label for="nombre" class="form-label">
                <strong>Nombre</strong>
              </label>
              <input type="text" name="nombre" class="form-control" />
            </div>
            <!-- Nacionalidad -->
            <div class="form-group mb-3">
              <label for="nacionalidad" class="form-label">
                <strong>Nacionalidad</strong>
              </label>
              <input type="text" name="nacionalidad" class="form-control" />
            </div>
            <!-- Carátula -->
            <div class="form-group mb-3">
              <label for="caratula" class="form-label">
                <strong>Carátula (URL)</strong>
              </label>
              <input type="text" name="caratula" class="form-control" />
            </div>
            <!-- Info -->
            <div class="form-group mb-3">
              <label for="info" class="form-label">
                <strong>Información</strong>
              </label>
              <textarea name="info" class="form-control"></textarea>
            </div>
            <!-- Botones -->
            <div class="d-flex justify-content-between mt-4">
              <a href="/cantantes?<%= query %>" class="btn btn-volver"> ← Volver </a>
              <button class="btn btn-success">Guardar intérprete</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/_footer') %>
