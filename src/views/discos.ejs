<% include partials/_header %>

<div class="container">
  <!-- Barra A-Z -->
  <%- include('partials/_barraAZ', {
    letrasExistentes,
    letra,
    rutaBase: '/discos',
    queryPagina: 'paginaCantantes'
  }) %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">
      Discos
    </h1>
    <div class="d-flex align-items-center gap-3">
      <% if(user) { %>
        <a href="/discos/nuevo?<%= query %>" class="btn btn-primary">
          + Añadir disco
        </a>
      <% } %>
      <span class="text-muted">
        Página <%= paginaCantantes %> de <%= paginas %>
      </span>
    </div>
  </div>
  <% interpretesConDiscos.forEach(grupo => { %>
    <% if(grupo.discos.length > 0) { %>
      <!-- Nombre intérprete -->
      <div class="mb-4 mt-5">
        <h2 class="text-warning fw-bold">
          🎤 
          <a href="/verCantante/<%= grupo.interprete._id %>?<%= query %>" class="text-decoration-none text-warning">
            <%= grupo.interprete.nombre %>
          </a>
        </h2>
      </div>
      <!-- discos -->
      <div class="row g-4 mb-5">
        <% grupo.discos.forEach(disco => { %>
          <div class="col-6 col-md-3 col-lg-2">
            <div class="card-musica">
              <div class="text-center">
                <a href="/verDisco/<%= disco._id %>?<%= query %>">
                  <img src="<%= disco.caratula %>" alt="<%= disco.titulo %>" class="img-fluid rounded shadow-sm mb-2" style="height: 260px; object-fit: contain; background-color: #111;" onerror="this.onerror=null; this.src='/img/no-cover.jpg'">
                </a>
                <h6 class="text-light">
                  <a href="/verDisco/<%= disco._id %>?<%= query %>" class="text-decoration-none text-light">
                    <%= disco.titulo %>
                  </a>
                </h6>
                <small class="text-muted">
                  <%= disco.anyo %>
                </small>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  <% }) %>
  <!-- PAGINACIÓN -->
  <%- include('partials/_paginacion', {
    letra,
    pagina: paginaCantantes,
    paginas,
    rutaBase: '/discos',
    queryPagina: 'paginaCantantes'
  }) %>
</div>

<% include partials/_footer %>