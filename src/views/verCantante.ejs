<% include partials/_header %>

<div class="container">
  <!-- Cabecera intérprete -->
  <div class="card shadow-lg border-0 mb-5">
    <div class="row g-0">
      <!-- Imagen -->
      <div class="col-lg-4 text-center p-4">
        <img src="<%= interprete.caratula %>" alt="<%= interprete.nombre %>" class="img-fluid rounded shadow" style="max-height: 450px; object-fit: contain; background-color: #111;" onerror="this.onerror=null; this.src='/img/no-image.png'">
      </div>
      <!-- Información -->
      <div class="col-lg-8">
        <div class="card-body h-100 d-flex flex-column justify-content-center">
          <h1 class="display-4 fw-bold mb-3">
            🎤 <%= interprete.nombre %>
          </h1>
          <% if(interprete.nacionalidad) { %>
            <p class="fs-5 text-muted mb-4">
              🌍 <%= interprete.nacionalidad %>
            </p>
          <% } %>
          <% if(interprete.info) { %>
            <div class="alert alert-dark">
              <%= interprete.info %>
            </div>
          <% } %>
          <!-- Botones crud -->
          <% if(user) { %>
            <div class="d-flex flex-wrap gap-2 mt-3">
              <a href="/editCantante/<%= interprete._id %>" class="btn btn-success">
                Editar intérprete
              </a>
              <form action="/deleteCantante/<%= interprete._id %>?_method=DELETE" method="post">
                <input type="hidden" name="_method" value="DELETE">
                <button class="btn btn-danger delete" type="submit">
                  Eliminar intérprete
                </button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <!-- Discografía -->
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>
        💿 Discografía
      </h2>
      <span class="text-muted">
        <strong><%= totalDiscos %></strong> discos
      </span>
    </div>
    <div class="row g-4">
      <% discos.forEach(disco => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-sm border-0 h-100 hover-card">
            <!-- Carátula -->
            <a href="/verDisco/<%= disco._id %>?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>">
              <img src="<%= disco.caratula %>" alt="<%= disco.titulo %>" class="card-img-top p-3" style="height: 320px; object-fit: contain; background-color: #111;" onerror="this.onerror=null; this.src='/img/no-cover.jpg'">
            </a>
            <!-- Info -->
            <div class="card-body d-flex flex-column">
              <h5 class="card-title">
                <a href="/verDisco/<%= disco._id %>?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>" class="text-decoration-none text-light">
                  <%= disco.titulo %>
                </a>
              </h5>
              <p class="text-muted mb-3">
                📅 <%= disco.anyo %>
              </p>
              <div class="mt-auto">
                <a href="/verDisco/<%= disco._id %>?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>" class="btn btn-outline-primary btn-sm">
                  Ver disco
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <!-- Paginación discos -->
    <% if (paginasDiscos > 1) { %>
      <nav class="text-center mt-4">
        <ul class="pagination justify-content-center">
          <!-- Anterior -->
          <% if (paginaDiscos > 1) { %>
            <li class="page-item">
              <a href="/verCantante/<%= interprete._id %>?paginaDiscos=<%= paginaDiscos - 1 %>">
                Anterior
              </a>
            </li>
          <% } else { %>
            <li>
              <button class="btn btn-sm btn-secondary me-2" disabled>
                Anterior
              </button>
            </li>
          <% } %>
          <%
            const paginaActual = Number(paginaDiscos);
            let inicio = paginaActual - 4;
            let fin = paginaActual + 4;
            if(inicio < 1) {
              inicio = 1;
              fin = Math.min(9, paginasDiscos);
            }
            if(fin > paginasDiscos) {
              fin = paginasDiscos;
              inicio = Math.max(1, paginasDiscos - 8);
            }
          %>
          <!-- números -->
          <% for(let i=inicio; i<=fin; i++) { %>
            <li class="page-item <%= i === paginaActual ? 'active' : '' %>">
              <a href="/verCantante/<%= interprete._id %>?paginaDiscos=<%= i %>" class="page-link">
                <%= i %>
              </a>
            </li>
          <% } %>
          <!-- siguiente -->
          <% if (paginaDiscos < paginasDiscos) { %>
            <li class="page-item">
              <a href="/verCantante/<%= interprete._id %>?paginaDiscos=<%= paginaDiscos + 1 %>">
                Siguiente
              </a>
            </li>
          <% } else { %>
            <li>
              <button class="btn btn-sm btn-secondary ms-2" disabled>
                Siguiente
              </button>
            </li>
          <% } %>
        </ul>
      </nav>
    <% } %>
  </div>
  <!-- Volver -->
  <div class="text-center mb-5">
    <a href="/cantantes?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>" class="btn btn-volver">
      Volver a intérprete
    </a>
    <a href="/discos?<%= letra ? `letra=${letra}&` : '' %>pagina=<%= pagina %>" class="btn btn-volver">
      Volver a discos
    </a>
  </div>
</div>
<script>
  let botones = document.querySelectorAll('.delete');
  for (const boton of botones) {  
    boton.addEventListener('click', (e) => {
      let respuesta = confirm('¿Estás seguro de querer eliminar este cantante?');
      if(!respuesta) {
        e.preventDefault();
      }
    });
  }
</script>

<% include partials/_footer %>