<%- include('partials/_header') %>

<div class="container">
  <!-- Barra A-Z -->
  <%- include('partials/_barraAZ', {
    letrasExistentes,
    letra,
    rutaBase: '/canciones',
    queryPagina: 'paginaCantantes'
  }) %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">
      🎵 Canciones
    </h1>
    <div class="d-flex align-items-center gap-3">
      <% if(user) { %>
        <a href="/canciones/nueva?<%= query %>" class="btn btn-primary">
          + Añadir canción
        </a>
      <% } %>
      <span class="text-muted">
        Página <%= paginaCantantes %> de <%= paginas %>
      </span>
    </div>
  </div>
  <% interpretesConDiscos.forEach(grupo => { %>
    <%- include('partials/_grupoCanciones', {
       grupo,
       letra,
       paginaCantantes,
       query
    }) %>
  <% }) %>
  <!-- Paginación -->
  <%- include('partials/_paginacion', {
    letra,
    pagina: paginaCantantes,
    paginas,
    rutaBase: '/canciones',
    queryPagina: 'paginaCantantes'
  }) %> 
</div>
    
<%- include('partials/_footer') %>